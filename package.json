{
    "name": "crabtable",
    "type": "module",
    "version": "0.17.0",
    "private": true,
    "author": "DreamNum Co., Ltd. <developer@crabtable.dev>",
    "license": "Apache-2.0",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/crabtable"
    },
    "homepage": "https://crabtable.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/AutoCookies/crabtable"
    },
    "bugs": {
        "url": "https://github.com/AutoCookies/crabtable/issues"
    },
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "common/*",
        "examples",
        "packages/*",
        "tests/*"
    ],
    "scripts": {
        "prepare": "husky",
        "pre-commit": "lint-staged",
        "dev": "yarn workspace crabtable-examples dev:demo -- --host 0.0.0.0",
        "dev:libs": "yarn workspace crabtable-examples dev:demo-libs",
        "dev:e2e": "yarn workspace crabtable-examples dev:e2e",
        "use:react16": "tsx ./scripts/react-version-manager.ts --react=16",
        "use:react19": "tsx ./scripts/react-version-manager.ts --react=19",
        "typecheck": "turbo typecheck",
        "test": "turbo test -- --passWithNoTests",
        "coverage": "turbo coverage -- --passWithNoTests",
        "build": "turbo build --concurrency=30% --filter=!./common/*",
        "build:ci": "turbo build --concurrency=100% --filter=!./common/*",
        "build:demo": "yarn workspace crabtable-examples build:demo",
        "build:e2e": "yarn workspace crabtable-examples build:e2e",
        "serve:e2e": "serve ./examples/local",
        "test:e2e": "playwright test",
        "lint": "eslint .",
        "storybook:dev": "yarn workspace @crabtable/storybook dev:storybook",
        "storybook:build": "yarn workspace @crabtable/storybook build:storybook",
        "publish:all": "node scripts/publish-workspaces.mjs",
        "release": "release-it"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^7.7.0",
        "@commitlint/cli": "^20.4.3",
        "@commitlint/config-conventional": "^20.4.3",
        "@eslint-react/eslint-plugin": "^2.13.0",
        "@eslint/compat": "^2.0.3",
        "@playwright/test": "^1.57.0",
        "@release-it-plugins/workspaces": "^5.0.3",
        "@release-it/conventional-changelog": "^10.0.5",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^25.3.5",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@crabtable-infra/shared": "*",
        "@crabtable/design": "*",
        "@vitejs/plugin-react": "^5.1.4",
        "eslint": "10.0.3",
        "eslint-plugin-format": "^2.0.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "fs-extra": "^11.3.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "posthog-node": "^5.28.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "release-it": "^19.2.4",
        "serve": "^14.2.6",
        "tailwindcss": "3.4.18",
        "tsx": "^4.21.0",
        "turbo": "^2.8.14",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "resolutions": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": "eslint --fix"
    }
}

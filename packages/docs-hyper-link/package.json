{
    "name": "@crabtable/docs-hyper-link",
    "version": "0.17.0",
    "private": false,
    "description": "Univer thread comment plugin",
    "author": "DreamNum <developer@crabtable.dev>",
    "license": "Apache-2.0",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/crabtable"
    },
    "homepage": "https://crabtable.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/AutoCookies/crabtable"
    },
    "bugs": {
        "url": "https://github.com/AutoCookies/crabtable/issues"
    },
    "keywords": [],
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*"
    },
    "main": "./src/index.ts",
    "types": "./lib/types/index.d.ts",
    "publishConfig": {
        "access": "public",
        "main": "./lib/es/index.js",
        "module": "./lib/es/index.js",
        "exports": {
            ".": {
                "import": "./lib/es/index.js",
                "require": "./lib/cjs/index.js",
                "types": "./lib/types/index.d.ts"
            },
            "./*": {
                "import": "./lib/es/*",
                "require": "./lib/cjs/*",
                "types": "./lib/types/index.d.ts"
            },
            "./lib/*": "./lib/*"
        }
    },
    "directories": {
        "lib": "lib"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "build": "univer-cli build"
    },
    "dependencies": {
        "@crabtable/core": "*"
    },
    "devDependencies": {
        "@crabtable-infra/shared": "*",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    }
}

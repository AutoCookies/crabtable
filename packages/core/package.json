{
    "name": "@crabtable/core",
    "version": "0.17.0",
    "private": false,
    "description": "Core library for CrabTable.",
    "author": "DreamNum <developer@crabtable.dev>",
    "license": "Apache-2.0",
    "funding": {
        "type": "opencollective",
        "url": "https://opencollective.com/crabtable"
    },
    "homepage": "https://crabtable.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/AutoCookies/crabtable"
    },
    "bugs": {
        "url": "https://github.com/AutoCookies/crabtable/issues"
    },
    "keywords": [
        "crabtable"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*",
        "./facade": "./src/facade/index.ts"
    },
    "main": "./src/index.ts",
    "types": "./lib/types/index.d.ts",
    "publishConfig": {
        "access": "public",
        "main": "./lib/es/index.js",
        "module": "./lib/es/index.js",
        "exports": {
            ".": {
                "import": "./lib/es/index.js",
                "require": "./lib/cjs/index.js",
                "types": "./lib/types/index.d.ts"
            },
            "./*": {
                "import": "./lib/es/*",
                "require": "./lib/cjs/*",
                "types": "./lib/types/index.d.ts"
            },
            "./facade": {
                "import": "./lib/es/facade.js",
                "require": "./lib/cjs/facade.js",
                "types": "./lib/types/facade/index.d.ts"
            },
            "./lib/facade": {
                "import": "./lib/es/facade.js",
                "require": "./lib/cjs/facade.js",
                "types": "./lib/types/facade/index.d.ts"
            },
            "./lib/*": "./lib/*"
        }
    },
    "directories": {
        "lib": "lib"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "build": "univer-cli build"
    },
    "peerDependencies": {
        "@wendellhu/redi": "1.1.1",
        "rxjs": ">=7.0.0"
    },
    "dependencies": {
        "@univerjs/protocol": "0.1.48",
        "@crabtable/themes": "*",
        "@wendellhu/redi": "1.1.1",
        "async-lock": "^1.4.1",
        "dayjs": "^1.11.19",
        "fast-diff": "1.3.0",
        "kdbush": "^4.0.2",
        "lodash-es": "^4.17.23",
        "nanoid": "5.1.6",
        "numfmt": "^3.2.3",
        "ot-json1": "^1.0.2",
        "rbush": "^4.0.1"
    },
    "devDependencies": {
        "@types/async-lock": "^1.4.2",
        "@types/lodash-es": "^4.17.12",
        "@types/rbush": "^4.0.0",
        "@crabtable-infra/shared": "*",
        "rxjs": "^7.8.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    }
}
